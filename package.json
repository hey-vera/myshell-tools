{
  "name": "myshell-tools",
  "version": "3.170.0",
  "type": "module",
  "bin": {
    "myshell-tools": "dist/cli.js",
    "myshell": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run test/unit test/arch",
    "test:watch": "vitest test/unit test/arch",
    "test:ui": "vitest run test/ui",
    "test:contract": "vitest run test/contract",
    "test:e2e": "CORTEX_E2E=1 vitest run test/integration",
    "eval": "node --import tsx/esm src/cli.ts eval",
    "lint": "eslint src test",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test:integration": "vitest run test/integration",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run build",
    "smoke:pty": "MYSHELL_INK=0 node scripts/pty-smoke.mjs",
    "smoke:pty:handoff": "node scripts/pty-smoke-handoff.mjs",
    "smoke:pty:ink": "node scripts/pty-smoke-ink.mjs",
    "smoke:pty:menu-ink": "node scripts/pty-smoke-menu-ink.mjs",
    "smoke:checklist": "node scripts/checklist-smoke.mjs",
    "smoke:repo-chat": "node --import tsx/esm scripts/pty-smoke.mjs",
    "bench:p0": "node scripts/pty-p0-benchmark.mjs",
    "auto-brain:preview": "node --import tsx/esm scripts/auto-brain-preview.mjs",
    "auto-brain:preview:pasted-code": "node --import tsx/esm scripts/auto-brain-preview.mjs pasted-code",
    "auto-brain:preview:find-and-fix-bug": "node --import tsx/esm scripts/auto-brain-preview.mjs find-and-fix-bug"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-vera/myshell-tools.git"
  },
  "author": "HeyVera <hello@heyvera.org>",
  "license": "MIT",
  "keywords": [
    "ai",
    "orchestration",
    "cli",
    "claude",
    "codex",
    "multi-model"
  ],
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.9",
    "@xterm/headless": "^6.0.0",
    "c8": "^10.0.0",
    "eslint": "^9.0.0",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.14.2",
    "prettier": "^3.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "ink": "^6.8.0",
    "react": "^19.2.7"
  }
}
