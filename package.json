{
  "name": "myshell-tools",
  "version": "3.29.6",
  "type": "module",
  "bin": {
    "myshell-tools": "dist/cli.js",
    "myshell": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import ./test/register.mjs --experimental-strip-types --test \"test/unit/**/*.test.ts\" \"test/arch/**/*.test.ts\"",
    "test:ui": "tsx --test \"test/ui/**/*.test.tsx\"",
    "test:contract": "node --import ./test/register.mjs --experimental-strip-types --test \"test/contract/**/*.test.ts\"",
    "test:e2e": "CORTEX_E2E=1 node --import ./test/register.mjs --experimental-strip-types --test \"test/integration/**/*.test.ts\"",
    "lint": "eslint src test",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run build",
    "smoke:pty": "MYSHELL_INK=0 node scripts/pty-smoke.mjs",
    "smoke:pty:handoff": "node scripts/pty-smoke-handoff.mjs",
    "smoke:pty:ink": "node scripts/pty-smoke-ink.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-vera/myshell-tools.git"
  },
  "author": "HeyVera <hello@heyvera.org>",
  "license": "MIT",
  "keywords": [
    "ai",
    "orchestration",
    "cli",
    "claude",
    "codex",
    "multi-model"
  ],
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@xterm/headless": "^6.0.0",
    "c8": "^10.0.0",
    "eslint": "^9.0.0",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.14.2",
    "prettier": "^3.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "ink": "^6.8.0",
    "react": "^19.2.7"
  }
}
